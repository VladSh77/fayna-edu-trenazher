{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bank of Questions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "text", "type", "options"],
    "properties": {
      "id": {
        "type": "string"
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": ["single", "multiple", "text", "match"]
      },
      "options": {
        "type": "array",
        "minItems": 1
      },
      "explain": {
        "type": "string"
      },
      "correct": {
        "type": ["string", "array"]
      },
      "reference": {
        "type": "string"
      }
    }
  }
}
